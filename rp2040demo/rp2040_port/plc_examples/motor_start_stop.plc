; ================================================================
; PLC 测试程序：简单的电机启停控制 + 定时器 + 计数器演示
; 
; 功能：
;   X0 = 启动按钮 (常开)
;   X1 = 停止按钮 (常闭，正常接通)
;   Y0 = 电机输出
;   M0 = 运行保持继电器
;   T0 = 延时停止定时器 (5秒)
;   C0 = 启动次数计数器
;   D0 = 当前扫描周期 (ms)
;   D1 = 最大扫描周期 (ms)
; ================================================================

; 主程序标号
LABEL 0:
; --- 启动逻辑：X0 按下 -> M0 置位 (自保持) ---
LD  X0          ; 读取启动按钮
AND M0          ; 已运行时不重复置位
ORI X1          ; 停止按钮未按下 (常闭，按下为 0)
OUT M0          ; M0 自保持

; --- 电机输出：M0 导通 -> Y0 输出 ---
LD  M0
OUT Y0

; --- 延时停止：M0 断开后延时 5 秒断开 Y0 ---
LD  M0
TMR T0 K50      ; 100ms 基准，50 = 5秒

; --- 启动次数计数：M0 上升沿计数 ---
LD  M0
PLS M100        ; M100 检测 M0 上升沿
LD  M100
CNT C0 K1000    ; 计数到 1000 次

; --- 监控数据更新 ---
; D0 = 当前扫描周期, D1 = 最大扫描周期
; (由 PLC 核心自动更新 V0, V1，这里演示读取)
MOV V0 D0       ; V0 = 当前扫描周期
MOV V1 D1       ; V1 = 最大扫描周期

; --- 程序结束 ---
END

; 子程序示例 (未使用)
; LABEL 1:
;   RET