; ================================================================
; PLC 测试程序：温度 PID 控制 + Modbus 通信 + 数据处理演示
;
; 功能：
;   - 模拟温度采集 (D10 = 当前温度 PV, 单位 0.1℃)
;   - PID 控制加热器输出 (Y1 = 加热器, PWM 控制)
;   - 设定值 SV = D20 (默认 250 = 25.0℃)
;   - PID 参数：Kp=D30(放大100倍), Ki=D31, Kd=D32
;   - Modbus RTU 读取从站寄存器 (模拟)
;   - 数据记录：最大/最小温度存 D40/D41
;   - 报警：过温 Y2, 传感器故障 Y3
; ================================================================

; ===== 初始化段 (首次运行) =====
LD  SM0         ; 首次扫描标志 (内部特殊位，假设 SM0=首次扫描=1)
MOV K250 D20    ; 默认设定值 25.0℃
MOV K500 D30    ; Kp = 5.00 (×100)
MOV K50 D31     ; Ki = 0.50 (×100)
MOV K100 D32    ; Kd = 1.00 (×100)
MOV K300 D40    ; 最大温度初值 30.0℃
MOV K100 D41    ; 最小温度初值 10.0℃
SET M0          ; PID 使能标志

; ===== 主控制回路 =====
LABEL 100:

; --- 读取温度传感器 (模拟：D10 由外部 ADC 任务更新) ---
; 实际应用中由 ADC 中断或 IPC 从 Core1 读取
; 这里演示：传感器故障检测 (D10 < -500 或 > 500 视为故障)
LD  M0          ; PID 使能
AND M1          ; 无传感器故障
PID D20 D10 D50 ; PID(SV=D20, PV=D10, 输出=D50)
; PID 结果在 D50 (0~32767 对应 PWM 占空比)

; --- PWM 输出加热器 (Y1) ---
; 简化：将 D50 映射到定时器控制 PWM
; 实际需结合硬件 PWM，这里用定时器模拟占空比
MOV D50 D60     ; 保存 PID 输出

; --- 温度报警判断 ---
; 过温报警 (PV > 300 = 30.0℃)
LD  M1          ; 传感器正常
CMP D10 K300    ; 比较 PV 与 30.0℃
LD  M8000       ; 比较结果 > (M8000)
OUT Y2          ; 过温报警输出

; 传感器故障检测
LD  M0
CMP D10 K500    ; PV > 50.0℃
LD  M8000
OR  M0
CMP D10 K-500   ; PV < -50.0℃
LD  M8001       ; 比较结果 < (M8001)
OUT M1          ; M1 = 传感器故障标志
LD  M1
OUT Y3          ; 故障报警输出

; --- 最大/最小值记录 ---
LD  M0
ZCP K-500 K500 D10  ; 确保在合理范围
LD  M8000           ; 在区间内
CMP D10 D40         ; PV > 最大值?
LD  M8000
MOV D10 D40         ; 更新最大值
LD  M0
CMP D41 D10         ; 最小值 > PV?
LD  M8001
MOV D10 D41         ; 更新最小值

; --- Modbus RTU 从站轮询 (模拟，实际由 MODRW 指令实现) ---
; MODRW D100 D101 D102 D103
; D100=从站地址(1), D101=功能码(3), D102=起始寄存器(0), D103=读取数量(10)
; 结果存 D200~D209

; --- 数据处理演示 ---
; BCD/BIN 转换 (用于 7 段显示)
BCD D10 D70       ; 温度转 BCD 码显示

; 算术运算：计算平均温度 (滑动窗口)
; 简化：D80 = (D80 * 9 + D10) / 10
MUL D80 K9 D80
ADD D80 D10 D80
DIV D80 K10 D80

; --- 步进序列控制演示 (SFC) ---
; S0=初始, S1=加热, S2=保温, S3=冷却
; 这里简化用 M 位模拟
LD  X2          ; 手动/自动切换
OUT M10         ; M10=自动模式

LD  M10
AND M0          ; 自动且 PID 使能
OUT S1          ; 进入加热步骤

; 程序结束
END

; ===== 中断/子程序区 (可选) =====
; LABEL 200:    ; 定时中断子程序 (1ms)
;   RET

; LABEL 201:    ; 通信中断子程序
;   RET