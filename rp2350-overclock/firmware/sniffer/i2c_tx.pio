; I2C 主机自测：SCL 用 SET 引脚（GP10），SDA 用 OUT 引脚（GP11）
; 每个字发 9 拍：8 位数据 + 1 拍 ACK 槽（槽内 SDA 置 1）
; SM 时钟 1 MHz（div 150），一拍约 11 µs → SCL ≈ 91 kHz
.program i2c_tx
.wrap_target
    pull block
    set x, 8
bitloop:
    set pins, 0 [3]     ; SCL 低
    out pins, 1 [1]     ; SDA = 位
    set pins, 1 [3]     ; SCL 高
    jmp x-- bitloop
.wrap
